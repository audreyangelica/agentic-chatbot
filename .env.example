# Copy this file to .env and adjust local values.

# OpenAI-compatible model endpoint
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-development
LLM_MODEL=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF:Q4_K_M
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=2048
LLM_MAX_OUTPUT_TOKENS=512

# Transcript conversion
AMI_DATA_DIR="/absolute/path/to/ami_public_manual_1.6.2"
PROCESSED_DATA_DIR=./data/processed
CANONICAL_TRANSCRIPT_FORMAT=json
LLM_NORMALIZATION_ENABLED=false
LLM_NORMALIZATION_CONFIDENCE_THRESHOLD=0.80
KEEP_RAW_EXTRACTION=true

# Upload limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.xml,.json,.txt,.md,.csv,.pdf,.docx

# Transcript-converter MCP server
CONVERTER_MCP_TRANSPORT=stdio
CONVERTER_MCP_HOST=127.0.0.1
CONVERTER_MCP_PORT=8090
CONVERTER_UPLOAD_ROOT=./data/uploads
CONVERTER_ARTIFACT_ROOT=./data/conversions

# Application defaults
APP_ENV=development
APP_TIMEZONE=Asia/Seoul
REQUIRE_EXTERNAL_ACTION_APPROVAL=true

# Enable these after the data pipeline and converter MCP are complete.
# REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/0
# CHAT_SESSION_TTL_SECONDS=86400
# AGENT_RUN_TTL_SECONDS=3600
# CONVERSION_JOB_TTL_SECONDS=3600

# Add provider credentials only when integrations are implemented.
# Never commit real secrets.
# EMAIL_MCP_URL=
# CALENDAR_MCP_URL=
# PROJECT_MCP_URL=
